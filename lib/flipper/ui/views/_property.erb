<input type="hidden" name="<%= base_name %>[type]" value="Property" />
<select name="<%= base_name %>[args][0]" class="form-select">
  <% if expression %>
    <option value="<%= expression.args[0].value %>" selected><%= expression.args[0].value %></option>
  <% end %>
  <% @expression_properties.keys.each do |property| %>
    <% unless expression && property == expression.args[0].value %>
      <option value="<%= property %>"><%= property %></option>
    <% end %>
  <% end %>
</select>
